#!/bin/bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

COMMANDS=("init" "update" "package" "build" "dep_install" "service" "vsc" "ros_pkg_install" "py_env" "cmake_dep")

usage() {
    echo "Usage: ws_tools <command> [options]"
    echo ""
    echo "Commands:"
    echo "  package          Pack workspace into a zip file"
    echo "  build            Build workspace (colcon build)"
    echo "  dep_install      Install packages from dpkgs/ (apt.txt + deb/)"
    echo "  service          Manage systemd service (-i install, -r remove)"
    echo "  vsc              Git operations (-module_clone/-mc, -safe)"
    echo "  ros_pkg_install  Install ROS2 packages (-trac_ik)"
    echo ""
    echo "Run 'ws_tools <command> -h' for help on a specific command."
    exit 0
}

if [ $# -eq 0 ]; then
    usage
fi

COMMAND="$1"
SCRIPT_FILE="$SCRIPT_DIR/scripts/${COMMAND}.sh"

case "$COMMAND" in
    init|update|package|build|dep_install|service|vsc|ros_pkg_install|py_env|cmake_dep)
        if [[ ! -f "$SCRIPT_FILE" ]]; then
            echo "Error: script not found: $SCRIPT_FILE"
            exit 1
        fi
        exec bash "$SCRIPT_FILE" "$@"
        ;;
    -h|--help|help)
        usage
        ;;
    *)
        echo "Error: unknown command '$COMMAND'"
        echo ""
        usage
        ;;
esac
